{
  "name": "yairink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "wa:start": "docker compose --env-file .env.docker up -d",
    "wa:stop": "docker compose --env-file .env.docker down",
    "wa:logs": "docker logs yairink-openwa-api --tail 80",
    "wa:watch-logs": "docker logs yairink-openwa-watcher --tail 50 -f",
    "cron:start": "docker compose --env-file .env.docker --profile cron up -d reminders-cron",
    "cron:stop": "docker compose --env-file .env.docker --profile cron stop reminders-cron",
    "cron:logs": "docker logs yairink-reminders-cron --tail 50 -f",
    "db:migrate": "tsx --env-file=.env.local db/migrate.mts",
    "db:seed": "tsx --env-file=.env.local db/seed.mts",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:seed-content",
    "db:seed-content": "tsx --env-file=.env.local db/seed-content.mts",
    "db:test": "tsx --env-file=.env.local db/test-connection.mts",
    "db:test-login": "tsx --env-file=.env.local db/test-login.mts",
    "auth:test-jwt": "tsx --env-file=.env.local db/test-jwt.mts",
    "reminders:run": "tsx --env-file=.env.local scripts/run-reminders.mts",
    "cron:reminders": "tsx --env-file=.env.local scripts/cron-reminders.mts",
    "autopush": "node scripts/autopush.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.6",
    "next": "^15.3.3",
    "nextjs-toploader": "^3.9.17",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}

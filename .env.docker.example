# Copia a .env.docker y ajusta antes de: docker compose --env-file .env.docker up -d

# Ruta al repo OpenWA clonado (relativa a YairInk)
OPENWA_DIR=../openWA/OpenWA

# Datos persistentes de WhatsApp (sesión, QR ya escaneado, API keys)
# IMPORTANTE: no borres esta carpeta o tendrás que escanear QR de nuevo
OPENWA_DATA_DIR=../openWA/OpenWA/data

OPENWA_API_PORT=2785
OPENWA_DASHBOARD_PORT=2886
OPENWA_NODE_ENV=production

# API key de OpenWA (en producción usa una clave segura, no dev-admin-key)
OPENWA_API_KEY=dev-admin-key

# Sesión de WhatsApp
OPENWA_SESSION_NAME=yairink
OPENWA_SESSION_ID=fd9f84d6-3dbd-435c-85fd-d8730470f2cf

# Cron recordatorios (servicio reminders-cron con --profile cron)
# Debe coincidir con CRON_SECRET en .env.local de la app Next.js
CRON_SECRET=cambia_este_secreto_cron
REMINDER_APP_URL=http://host.docker.internal:3000
REMINDER_CRON_INTERVAL_MS=600000

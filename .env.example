# Email notifications via Resend (optional)
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
STUDIO_EMAIL=hola@yairink.com
RESEND_FROM_EMAIL=YAIRINK <hola@yairink.com>

# JWT — genera uno seguro: openssl rand -base64 48
JWT_SECRET=cambia_este_secreto_minimo_32_caracteres

# PostgreSQL
# Local:
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5433/base_datos_name?sslmode=disable&connect_timeout=10
# Vercel / Neon (producción):
# DATABASE_URL=postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Admin login (db:seed crea este usuario)
ADMIN_EMAIL=admin@yairink.com
ADMIN_PASSWORD=cambia_esta_contraseña

# OpenWA — ver docker-compose.yml y .env.docker.example
# Local: npm run wa:start  |  Dashboard: http://localhost:2886
WHATSAPP_ENABLED=false
OPENWA_API_URL=http://localhost:2785/api
OPENWA_API_KEY=tu_api_key
OPENWA_SESSION_ID=fd9f84d6-3dbd-435c-85fd-d8730470f2cf

# WhatsApp del tatuador (recibe alertas de nuevas consultas)
# Si no se define, usa el whatsapp del sitio en la base de datos
ARTIST_NOTIFY_PHONE=573001234567

# Secreto para el cron de recordatorios (GET/POST /api/cron/appointment-reminders)
CRON_SECRET=cambia_este_secreto_cron

# Intervalo del cron local (ms). Default: 600000 = 10 minutos
REMINDER_CRON_INTERVAL_MS=600000

# URL pública de la app (enlaces de resumen de sesión por WhatsApp)
# Vercel: https://tu-proyecto.vercel.app o tu dominio custom
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL de la app cuando el cron corre en Docker (Next.js en el host)
REMINDER_APP_URL=http://host.docker.internal:3000

# Vercel Blob — subida de imágenes en producción (auto en Vercel al crear Blob Store)
# Local: omitir (usa public/uploads/). Producción: Vercel → Storage → Blob → Connect
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
